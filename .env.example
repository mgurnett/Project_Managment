# ==============================================================================
# Django Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the appropriate values for your environment.
# DO NOT commit .env containing production secrets or passwords to Git.
# ==============================================================================

# Set to 'on' or 'True' for local development; 'off' or 'False' for production
DEBUG=on

# Django secret key (Generate a secure key for production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# MariaDB / MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=Inventory
DB_USER=db_user
DB_PASSWORD=your_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# Alarm & Defaults
# ------------------------------------------------------------------------------
DEFAULT_ALARM=25

# ------------------------------------------------------------------------------
# Email Configuration (Optional)
# ------------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=on
# EMAIL_HOST_USER=alerts@example.com
# EMAIL_HOST_PASSWORD=your_email_password
# DEFAULT_FROM_EMAIL=alerts@example.com
